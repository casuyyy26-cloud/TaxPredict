{
  "installCommand": "npm install",
  "buildCommand": "CI=false npm run build && rm -rf node_modules .venv venv .vercel/python",
  "outputDirectory": "build",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "build/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}